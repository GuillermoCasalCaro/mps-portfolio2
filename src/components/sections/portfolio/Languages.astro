---
import CardListItem from "./CardListItem.astro";
import { languages } from "../../../config/cv.json";
---

<section class="bg-background px-10 lg:w-full" id="languages">
  <div class="container mx-auto lg:w-1/2">
    <h2 class="mb-12 text-center text-3xl font-semibold lg:text-5xl">Languages</h2>

    <ul class="flex flex-row flex-wrap justify-center gap-8 space-y-8 lg:gap-16 lg:space-y-0">
      {languages.map((item) => <CardListItem title={item.language} sub_title={item.level} />)}
    </ul>
  </div>
</section>
