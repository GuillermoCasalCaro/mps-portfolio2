---
const { title, sub_title, years, details, timespan } = Astro.props;
---

<li
  class="rounded-xl border border-default bg-offset p-5 shadow-lg transition-all duration-300 ease-in-out hover:-translate-y-1 hover:border-primary hover:bg-start hover:shadow-lg">
  <div class="flex flex-col items-start justify-between gap-6 sm:flex-row">
    <div class="">
      <h3 class="text-pretty text-3xl font-semibold">{title}</h3>
      <p class="text-xl font-medium text-secondary sm:pt-2">{sub_title}</p>
    </div>
    <div class="flex flex-col sm:items-end">
      <p class="whitespace-nowrap text-default">
        {years}
      </p>
      {
        timespan && (
          <p class="experience-timespan whitespace-nowrap text-default">{`(${timespan})`}</p>
        )
      }
    </div>
  </div>
  <p class="mt-4 text-lg leading-relaxed text-default">{details}</p>
</li>
